/dts-v1/;

#include "sun60i-a733.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Radxa Cubie A7Z";
	compatible = "radxa,cubie-a7z", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_vcc5v: regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_vcc5v>;
		gpios = <&pio 1 8 GPIO_ACTIVE_HIGH>; /* PB8 */
		enable-active-high;
	};
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&mmc0 {
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&reg_dldo1>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	status = "okay";
};

&mmc2 {
	pinctrl-0 = <&mmc2_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&reg_dcdc1>;
	vqmmc-supply = <&reg_bldo1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&r_i2c0 {
	status = "okay";

	/*
	 * FIXME: Vendor DTS uses "x-powers,axp8191" at @36; U-Boot currently
	 * binds "x-powers,axp318w" here. Verify PMIC register compatibility
	 * and LPDDR4 rail voltages on physical hardware.
	 */
	axp318: pmic@36 {
		compatible = "x-powers,axp318w", "x-powers,axp318";
		reg = <0x36>;

		regulators {
			reg_dcdc1: dcdc1 {
				regulator-name = "vcc-io";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			reg_dcdc2: dcdc2 {
				regulator-name = "vdd-cpul";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-always-on;
			};

			reg_dcdc3: dcdc3 {
				regulator-name = "vdd-cpub";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-always-on;
			};

			reg_dcdc4: dcdc4 {
				regulator-name = "vdd-gpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-always-on;
			};

			reg_dcdc5: dcdc5 {
				regulator-name = "vdd-sys";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-always-on;
			};

			reg_dcdc6: dcdc6 {
				regulator-name = "vddq-lpddr4";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			reg_dcdc7: dcdc7 {
				regulator-name = "vdd2-lpddr4";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			reg_bldo1: bldo1 {
				regulator-name = "vcc-1v8-io";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_bldo2: bldo2 {
				regulator-name = "vdd1-lpddr4";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_bldo4: bldo4 {
				regulator-name = "vcc-1v8-audio";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			reg_dldo1: dldo1 {
				regulator-name = "vcc-sd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			reg_eldo1: eldo1 {
				regulator-name = "vdd2h-lpddr4";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pb_pins>;
	pinctrl-names = "default";
	status = "okay";
};
