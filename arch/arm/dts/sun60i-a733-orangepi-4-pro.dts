/dts-v1/;

#include "sun60i-a733.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Xunlong Orange Pi 4 Pro";
	compatible = "xunlong,orangepi-4-pro", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_vcc5v: regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_vcc5v>;
		gpios = <&pio 1 8 GPIO_ACTIVE_HIGH>; /* PB8 */
		enable-active-high;
	};

	reg_vcc3v3_pcie: regulator-vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-pcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&r_pio 0 3 GPIO_ACTIVE_HIGH>; /* PL3 */
		enable-active-high;
	};
};

&ehci1 {
	status = "okay";
};

&combophy1 {
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_swout2>;
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; /* PF6 */
	bus-width = <4>;
	status = "okay";
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_pins>, <&mmc2_rst_pin>;
	vmmc-supply = <&reg_dcdc1>;
	vqmmc-supply = <&reg_bldo1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&osc {
	clock-frequency = <24000000>;
};

&pcie_rc {
	vpcie3v3-supply = <&reg_vcc3v3_pcie>;
	reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>; /* PD22 */
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_dcdc1>;
	vcc-pc-supply = <&reg_bldo1>;
	vcc-pf-supply = <&reg_dcdc1>;
	vcc-pg-supply = <&reg_bldo1>;
	vcc-pj-supply = <&reg_bldo2>;
	vcc-pk-supply = <&reg_bldo1>;
};

&r_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&r_i2c0_pl_pins>;
	clock-frequency = <400000>;
	status = "okay";

	axp318w: pmic@36 {
		compatible = "x-powers,axp318w";
		reg = <0x36>;

		regulators {
			reg_dcdc1: dcdc1 {
				regulator-name = "vcc-io";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			reg_dcdc2: dcdc2 {
				regulator-name = "vdd-cpul";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1400000>;
				regulator-always-on;
			};

			reg_dcdc3: dcdc3 {
				regulator-name = "vdd-cpub";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1400000>;
				regulator-always-on;
			};

			reg_dcdc4: dcdc4 {
				regulator-name = "vdd-gpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			reg_dcdc5: dcdc5 {
				regulator-name = "vdd-sys";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			reg_dcdc6: dcdc6 {
				regulator-name = "vddq-lpddr5";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <600000>;
				regulator-always-on;
			};

			reg_dcdc7: dcdc7 {
				regulator-name = "vdd2-lpddr5";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1120000>;
				regulator-always-on;
			};

			reg_bldo1: bldo1 {
				regulator-name = "vcc-1v8-io";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_bldo2: bldo2 {
				regulator-name = "vdd1-lpddr5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_bldo4: bldo4 {
				regulator-name = "vcc-1v8-audio";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			reg_dldo1: dldo1 {
				regulator-name = "vcc-sd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			reg_eldo1: eldo1 {
				regulator-name = "vdd2h-lpddr5";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			reg_swout1: swout1 {
				regulator-name = "vcc-ephy";
				regulator-always-on;
			};

			reg_swout2: swout2 {
				regulator-name = "vcc-gmac-io";
				regulator-always-on;
			};
		};
	};
};

&r_pio {
	vcc-pm-supply = <&reg_bldo1>;
};

/* Optional onboard SPI NOR flash footprint; unpopulated on standard SKUs. */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pc_pins>;
	status = "disabled";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb0_pins>;
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};
